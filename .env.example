# -------------------------------------------------------
# WarCry-CMS Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.
# -------------------------------------------------------

# App
APP_NAME=warcry
APP_URL=https://your-app.railway.app
APP_EMAIL=info@yourdomain.com
APP_COOKIE_NAME=Project-Reborn
APP_TIMEZONE=Europe/Berlin
APP_TIMEZONE_OFFSET=+1

# Web Database (MySQL/MariaDB)
DB_HOST=mysql.railway.internal
DB_USER=root
DB_PASS=
DB_NAME=warcry
DB_ENCODING=utf8

# Auth Database (game server auth DB)
AUTH_DB_HOST=mysql.railway.internal
AUTH_DB_USER=root
AUTH_DB_PASS=
AUTH_DB_NAME=auth
AUTH_DB_ENCODING=utf8

# Realm 1 (game server characters DB)
REALM1_NAME=Realm 1
REALM1_DESCR=Blizzlike
REALM1_DB_HOST=mysql.railway.internal
REALM1_DB_USER=root
REALM1_DB_PASS=
REALM1_DB_NAME=characters
REALM1_ADDRESS=127.0.0.1
REALM1_PORT=8085
REALM1_SOAP_PROTOCOL=http
REALM1_SOAP_ADDRESS=127.0.0.1
REALM1_SOAP_PORT=7878
REALM1_SOAP_USER=
REALM1_SOAP_PASS=

# WoW Item Database (optional, leave empty if not used)
WOWDB_URL=
WOWDB_JS=
